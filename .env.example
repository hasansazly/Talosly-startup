# Talosly Environment Configuration

# Ethereum RPC
ALCHEMY_API_KEY=your_alchemy_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}
ENABLE_MEMPOOL_SUBSCRIBER=false
MEMPOOL_BACKOFF_MAX_SECONDS=900
MEMPOOL_RATE_LIMIT_BACKOFF_SECONDS=900
ETHEREUM_BLOCKS_PER_POLL=1
ETHEREUM_INITIAL_LOOKBACK_BLOCKS=0
ETHEREUM_RPC_MIN_INTERVAL_SECONDS=5.0
ETHEREUM_RPC_MAX_RETRIES=1
ETHEREUM_RPC_RATE_LIMIT_BACKOFF_SECONDS=3600
ENABLE_RPC_POLLING=false
# Fallback public RPC (used if ALCHEMY_API_KEY is not set):
# ETHEREUM_RPC_URL=https://cloudflare-eth.com

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
GPT_DAILY_SPEND_ALERT_USD=5.00
ML_GATE_THRESHOLD=65
ML_CONFIDENCE_GATE=20
ENABLE_LAYER3_ML=true
LAYER3_MODEL_DIR=models
LAYER3_ESCALATION_THRESHOLD=0.55
LAYER4_ENABLED=true
LAYER4_MODEL=gpt-4o-mini
LAYER4_TIMEOUT_SECONDS=8
LAYER4_MAX_TOKENS=600
LAYER4_COST_LOG_FILE=logs/layer4_costs.jsonl
LAYER5_DEDUPE_WINDOW_S=300
LAYER5_CONFIDENCE_GATE=true
MODEL_RETRAIN_INTERVAL_DAYS=7

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Database
DATABASE_URL=postgresql://talosly:talosly_secret@localhost:5432/talosly
DATABASE_PUBLIC_URL=
POSTGRES_PASSWORD=talosly_secret

# Auth
API_KEY_SECRET_SALT=random_32_char_string_here
# Receipt signing
# Generate with: python -m kya.receipts.signing
# Store as a secret and never commit a real seed.
RECEIPT_SIGNING_SEED=
DECISION_BLOCK_BELOW=40
DECISION_REVIEW_BELOW=70
SIGNAL_MIN_OBSERVATIONS=30

# KYA
# ENABLE_KYA is the master API scoring gate; per-signal flags are independent rollback switches.
ENABLE_KYA=false
KYA_ENABLE_MAHALANOBIS=true
KYA_ENABLE_CHANGEPOINT=true
KYA_ENABLE_CONFORMAL=true

# Worker
POLL_INTERVAL_SECONDS=3600
RISK_ALERT_THRESHOLD=70

# Backend
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=5000

# Admin
ADMIN_SECRET=your_admin_secret_key_here_min_32_chars

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# App
APP_ENV=production
PUBLIC_URL=https://talosly.com

# Email
RESEND_API_KEY=your_resend_api_key_here
